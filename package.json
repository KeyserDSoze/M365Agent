{
  "name": "m365-agent-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "init": "node init/init.ts",
    "validate": "node scripts/validate.ts",
    "validate:prod": "node scripts/validate.ts --require-init --require-provisioned",
    "validate:toolkit": "node scripts/ci-validate.ts",
    "deploy:prod": "node scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.8.3"
  }
}

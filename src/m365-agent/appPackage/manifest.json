{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.26/MicrosoftTeams.schema.json",
  "manifestVersion": "1.26",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "M365 Agent Team",
    "websiteUrl": "https://github.com/KeyserDSoze/M365Agent",
    "privacyUrl": "https://github.com/KeyserDSoze/M365Agent/blob/main/docs/PRIVACY.md",
    "termsOfUseUrl": "https://github.com/KeyserDSoze/M365Agent/blob/main/docs/TERMS.md"
  },
  "name": {
    "short": "M365 Agent",
    "full": "M365 Agent - Boilerplate"
  },
  "description": {
    "short": "Assistente Microsoft 365 configurabile.",
    "full": "Boilerplate di un agente dichiarativo per Microsoft 365 Copilot, personalizzabile con fonti di conoscenza."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#1D4ED8",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "validDomains": []
}
